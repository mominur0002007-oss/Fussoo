<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are disabled (allowBackup=false). Playback positions and library settings stay on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
