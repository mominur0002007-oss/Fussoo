<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_group_viewer">

        <ListPreference
            android:key="viewer_profile"
            android:title="@string/pref_viewer_profile"
            android:summary="@string/pref_viewer_profile_desc"
            android:entries="@array/viewer_profile_entries"
            android:entryValues="@array/viewer_profile_values"
            app:useSimpleSummaryProvider="false" />

        <Preference
            android:key="calibrate_viewer"
            android:title="@string/pref_viewer_calibrate"
            android:summary="@string/pref_viewer_calibrate_desc"
            android:persistent="false" />

        <SeekBarPreference
            android:key="lens_separation_mm"
            android:title="@string/pref_lens_separation"
            android:summary="Millimetres between the two lens centres (mm)"
            app:min="45"
            app:max="85"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="fov_deg"
            android:title="@string/pref_fov"
            android:summary="Field of view per lens (degrees)"
            app:min="55"
            app:max="115"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="screen_lens_mm"
            android:title="@string/pref_screen_distance"
            android:summary="Physical distance from screen to lens (mm)"
            app:min="22"
            app:max="75"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="ipd_mm"
            android:title="@string/pref_ipd"
            android:summary="Your interpupillary distance (mm)"
            app:min="45"
            app:max="80"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="eye_offset_x_mm"
            android:title="@string/pref_eye_offset_x"
            android:summary="Shifts each eye image horizontally (mm)"
            app:min="-20"
            app:max="20"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="eye_offset_y_mm"
            android:title="@string/pref_eye_offset_y"
            android:summary="Shifts each eye image vertically (mm)"
            app:min="-20"
            app:max="20"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="distortion_k1_pct"
            android:title="@string/pref_distortion"
            android:summary="Barrel correction strength (x100)"
            app:min="0"
            app:max="60"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="distortion_k2_pct"
            android:title="Distortion falloff"
            android:summary="Higher-order correction (x100)"
            app:min="0"
            app:max="40"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="chromatic_milli"
            android:title="@string/pref_chromatic"
            android:summary="Colour fringing correction (x1000)"
            app:min="0"
            app:max="40"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:key="distortion_enabled"
            android:title="@string/pref_distortion_enabled"
            android:summary="@string/pref_distortion_enabled_desc"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="swap_eyes"
            android:title="Swap left / right eye"
            android:summary="Use when the box shows the screen halves mirrored"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_tracking">

        <SeekBarPreference
            android:key="tracking_smoothing_pct"
            android:title="@string/pref_tracking_smoothing"
            android:summary="0 = raw and snappy, 90 = very smooth"
            app:min="0"
            app:max="90"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="tracking_sensitivity_pct"
            android:title="@string/pref_tracking_sensitivity"
            android:summary="Head rotation multiplier (%)"
            app:min="40"
            app:max="200"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:key="recenter_on_start"
            android:title="@string/pref_tracking_recenter_on_start"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="comfort_fov"
            android:title="@string/pref_comfort_fov"
            android:summary="Narrower field of view reduces motion discomfort"
            android:defaultValue="false" />

        <Preference
            android:key="sensor_diagnostics"
            android:title="@string/pref_sensor_diagnostics"
            android:summary="@string/pref_sensor_diagnostics_desc"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_video">

        <ListPreference
            android:key="default_projection"
            android:title="@string/pref_default_projection"
            android:entries="@array/projection_entries"
            android:entryValues="@array/projection_values"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="default_stereo"
            android:title="@string/pref_default_stereo"
            android:entries="@array/stereo_entries"
            android:entryValues="@array/stereo_values"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="resume_playback"
            android:title="@string/pref_resume_playback"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="playback_speed_pct"
            android:title="@string/pref_playback_speed"
            android:summary="Percent of normal speed"
            app:min="50"
            app:max="200"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="subtitle_size"
            android:title="@string/pref_subtitle_size"
            android:summary="Subtitle text size (sp)"
            app:min="10"
            app:max="28"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="volume_pct"
            android:title="Playback volume"
            android:summary="Applied when playback starts (%)"
            app:min="10"
            app:max="100"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_graphics">

        <ListPreference
            android:key="graphics_quality"
            android:title="@string/pref_graphics_quality"
            android:summary="@string/pref_graphics_quality_desc"
            android:entries="@array/quality_entries"
            android:entryValues="@array/quality_values"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="adaptive_quality"
            android:title="@string/pref_adaptive_quality"
            android:summary="@string/pref_adaptive_quality_desc"
            android:defaultValue="true" />

        <ListPreference
            android:key="frame_limit"
            android:title="@string/pref_frame_limit"
            android:entries="@array/frame_limit_entries"
            android:entryValues="@array/frame_limit_values"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="show_fps"
            android:title="@string/pref_show_fps"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_interface">

        <ListPreference
            android:key="environment"
            android:title="@string/pref_environment"
            android:entries="@array/environment_entries"
            android:entryValues="@array/environment_values"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:key="screen_size_pct"
            android:title="@string/pref_screen_size"
            android:summary="Relative width of the virtual cinema screen (%)"
            app:min="40"
            app:max="220"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="screen_distance_dm"
            android:title="@string/pref_screen_distance_virtual"
            android:summary="Distance to the screen (decimetres)"
            app:min="25"
            app:max="160"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="curvature_pct"
            android:title="@string/pref_curvature"
            android:summary="0 = flat panel, 100 = strongly curved"
            app:min="0"
            app:max="100"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="screen_y_cm"
            android:title="Screen height offset"
            android:summary="Raises or lowers the screen (cm)"
            app:min="-150"
            app:max="150"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="dwell_ms"
            android:title="@string/pref_dwell_time"
            android:summary="How long to look at a panel before it activates (ms)"
            app:min="500"
            app:max="3000"
            app:showSeekBarValue="true" />

        <ListPreference
            android:key="selection_mode"
            android:title="@string/pref_selection_mode"
            android:entries="@array/selection_entries"
            android:entryValues="@array/selection_values"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:key="ui_scale_pct"
            android:title="@string/pref_ui_scale"
            android:summary="Size of the gaze reticle and controls (%)"
            app:min="60"
            app:max="160"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:key="keep_awake"
            android:title="@string/pref_keep_awake"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_storage">

        <Preference
            android:key="clear_resume"
            android:title="@string/pref_clear_resume"
            android:persistent="false" />

        <Preference
            android:key="clear_thumbs"
            android:title="@string/pref_clear_thumbnails"
            android:persistent="false" />

        <Preference
            android:key="storage_info"
            android:title="@string/pref_storage_info"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_group_about">

        <Preference
            android:key="battery_info"
            android:title="@string/pref_battery_info"
            android:summary="@string/pref_battery_info_desc"
            android:persistent="false" />

        <Preference
            android:key="device_report"
            android:title="@string/pref_device_report"
            android:persistent="false" />

        <Preference
            android:key="licenses"
            android:title="@string/pref_licenses"
            android:persistent="false" />

        <Preference
            android:key="version_info"
            android:title="@string/pref_about"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
