<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TuVr" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/bg_surface_raised</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_violet</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorSurfaceVariant">@color/bg_surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/glass_stroke</item>
        <item name="android:colorBackground">@color/bg_deep</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialAlertDialogTheme">@style/Theme.TuVr.Dialog</item>
        <item name="preferenceTheme">@style/Theme.TuVr.Preference</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="Theme.TuVr.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent</item>
    </style>

    <style name="Theme.TuVr.Preference" parent="Preference.Material">
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- Immersive VR host activities -->
    <style name="Theme.TuVr.Immersive" parent="Theme.TuVr">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Glass style card used across the phone UI -->
    <style name="Widget.TuVr.GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="Widget.TuVr.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.TuVr.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/bg_surface_raised</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.TuVr.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:tint">@color/text_primary</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <style name="Text.TuVr.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle-bold">true</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.TuVr.Headline">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.TuVr.Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Text.TuVr.Caption">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Text.TuVr.SectionLabel" parent="Text.TuVr.Caption">
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent_dim</item>
    </style>
</resources>
