<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FussooVR" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#FF3B30</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#3A0A0A</item>
        <item name="colorOnPrimaryContainer">#FFDAD6</item>
        <item name="colorSecondary">#8FB7FF</item>
        <item name="colorSurface">#0B0D13</item>
        <item name="colorSurfaceVariant">#161A24</item>
        <item name="colorOnSurface">#F5F7FA</item>
        <item name="colorOnSurfaceVariant">#9AA3B2</item>
        <item name="colorOutline">#2A3040</item>
        <item name="android:colorBackground">#05060A</item>
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/space_grotesk_family</item>
        <item name="fontFamily">@font/space_grotesk_family</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/space_grotesk_family</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Wordmark" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/space_grotesk_family</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/space_grotesk_family</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Fussoo.Button" parent="Widget.Material3.Button">
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk_family</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Fussoo.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk_family</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">#14FFFFFF</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Fussoo.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:fontFamily">@font/space_grotesk_family</item>
        <item name="chipBackgroundColor">#14FFFFFF</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">#1FFFFFFF</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="Widget.Fussoo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">#0EFFFFFF</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#1FFFFFFF</item>
    </style>

    <style name="Widget.Fussoo.Search" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxStrokeColor">#33FFFFFF</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
</resources>
